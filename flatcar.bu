variant: flatcar
version: 1.1.0
storage:
  directories:
    - path: /opt/bin
      mode: 0755
  files:
    - path: /etc/systemd/network/10-qemu.network
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=eth0

          [Network]
          DHCP=yes
          DNS=1.1.1.1

          [DHCPv4]
          UseDNS=no

          [IPv6AcceptRA]
          UseDNS=no
systemd:
  units:
    - name: install-k3s.service
      enabled: true
      contents: |
        [Unit]
        Description=Download & Install Multi-Arch K3s Binary
        Wants=network-online.target
        After=network-online.target
        ConditionPathExists=!/opt/bin/k3s

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=/usr/bin/mkdir -p /opt/bin
        ExecStart=:/bin/sh -c 'ARCH=$(uname -m); if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then SUFFIX="-arm64"; else SUFFIX=""; fi; /usr/bin/curl -sfL "https://github.com/k3s-io/k3s/releases/download/v1.35.8%%2Bk3s1/k3s$SUFFIX" -o /opt/bin/k3s'
        ExecStartPost=/usr/bin/chmod +x /opt/bin/k3s

        [Install]
        WantedBy=multi-user.target
    - name: k3s.service
      enabled: true
      contents: |
        [Unit]
        Description=Lightweight Kubernetes Server (K3s)
        Documentation=https://k3s.io
        Wants=network-online.target
        Requires=install-k3s.service
        After=network-online.target install-k3s.service

        [Service]
        Type=notify
        EnvironmentFile=-/etc/default/%N
        Environment=K3S_NODE_NAME=%H
        Environment=K3S_DATA_DIR=/var/lib/rancher/k3s
        ExecStartPre=-/sbin/modprobe br_netfilter
        ExecStartPre=-/sbin/modprobe overlay
        ExecStart=/opt/bin/k3s server
        KillMode=process
        Delegate=yes
        LimitNOFILE=1048576
        LimitNPROC=infinity
        LimitCORE=infinity
        TasksMax=infinity
        TimeoutStartSec=0
        Restart=always
        RestartSec=5s

        [Install]
        WantedBy=multi-user.target
    - name: flux-bootstrap.service
      enabled: true
      contents: |
        [Unit]
        Description=Bootstrap FluxCD GitOps Controller
        Requires=k3s.service
        After=k3s.service
        ConditionPathExists=!/opt/flux-installed

        [Service]
        Type=oneshot
        Restart=on-failure
        RestartSec=15s
        TimeoutStartSec=15min
        Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
        ExecStartPre=/bin/sh -c 'echo "Waiting for K3s API server ready..."; until /opt/bin/k3s kubectl get nodes; do sleep 3; done'
        ExecStart=/opt/bin/k3s kubectl apply -f https://github.com/fluxcd/flux2/releases/download/v2.9.5/install.yaml
        ExecStartPost=/opt/bin/k3s kubectl wait --for=condition=Established crd/gitrepositories.source.toolkit.fluxcd.io crd/kustomizations.kustomize.toolkit.fluxcd.io --timeout=120s
        ExecStartPost=/opt/bin/k3s kubectl apply -f https://raw.githubusercontent.com/shipitdev/flatcar-gitops-k3s/master/k8s/flux-sync.yaml
        ExecStartPost=/usr/bin/touch /opt/flux-installed

        [Install]
        WantedBy=multi-user.target
